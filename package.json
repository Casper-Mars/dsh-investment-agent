{
  "name": "dsh-ia",
  "version": "0.1.1",
  "type": "module",
  "description": "金融投资专家 Agent 插件（dsh）：投资建议、持仓记账、行情/交易日历与市场感知",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "finance",
    "stock",
    "investment",
    "agent"
  ],
  "author": "Casper <solitaryreach@163.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casper-Mars/dsh-investment-agent.git"
  },
  "homepage": "https://github.com/Casper-Mars/dsh-investment-agent#readme",
  "bugs": {
    "url": "https://github.com/Casper-Mars/dsh-investment-agent/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.7.0",
    "dsh": "^0.2.0-rc.2"
  },
  "main": "dist-server/index.js",
  "exports": {
    ".": {
      "types": "./dist-server/types/index.d.ts",
      "default": "./dist-server/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-server/**/*.js",
    "dist-server/types/**/*.d.ts",
    "dist-server/**/*.md",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "prepublishOnly": "pnpm build",
    "build:server": "pnpm clean && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "recompute:cum-return": "node scripts/recompute-cum-return.mjs",
    "test": "vitest run --passWithNoTests",
    "wiki": "node scripts/wiki.mjs",
    "wiki:check": "node scripts/wiki.mjs --check",
    "clean": "rm -rf dist dist-server"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}